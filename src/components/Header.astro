---
/**
 * Replicates the WordPress header template part.
 *
 * On the front page the header *is* the hero: one full-bleed cover block at
 * 100vh with a muted background video. Inner pages use a compact variant with
 * no video and the site title in place of the hero copy.
 */
import { site, nav, hero, euFunding } from '../config/site'
import { withBase } from '../lib/base'

interface Props {
  variant?: 'home' | 'inner'
  currentPath?: string
}

const { variant = 'inner', currentPath = '' } = Astro.props
const isHome = variant === 'home'
---

<header class="wp-block-template-part">
  <div
    class:list={['site-cover', isHome ? 'site-cover--home' : 'site-cover--inner']}
  >
    {
      isHome && (
        <video
          class="site-cover__video"
          src={withBase(hero.video)}
          poster={withBase(hero.poster)}
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-hidden="true"
          tabindex="-1"
        />
      )
    }
    <span class="site-cover__overlay" aria-hidden="true"></span>

    <div class="site-cover__inner has-global-padding">
      <div class="site-bar">
        <a class="site-logo" href={withBase('/')}>
          <img
            src={withBase(site.logo.src)}
            alt={site.logo.alt}
            width="320"
            height="180"
            fetchpriority={isHome ? 'high' : undefined}
          />
        </a>

        <nav class="site-nav" aria-label="Primary">
          <button
            class="site-nav__toggle"
            type="button"
            aria-expanded="false"
            aria-controls="primary-menu"
          >
            <span class="screen-reader-text">Menu</span>
            <span class="site-nav__bars" aria-hidden="true"></span>
          </button>

          <ul class="site-nav__list" id="primary-menu">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={withBase(item.href)}
                    class="wp-block-button__link"
                    aria-current={currentPath === item.href ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                class="site-nav__social"
                href={site.linkedin}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                  <path
                    d="M19.7 3H4.3A1.3 1.3 0 0 0 3 4.3v15.4A1.3 1.3 0 0 0 4.3 21h15.4a1.3 1.3 0 0 0 1.3-1.3V4.3A1.3 1.3 0 0 0 19.7 3ZM8.339 18.338H5.667v-8.59h2.672v8.59ZM7.004 8.574a1.548 1.548 0 1 1-.002-3.096 1.548 1.548 0 0 1 .002 3.096Zm11.335 9.764H15.67v-4.177c0-.996-.017-2.278-1.387-2.278-1.389 0-1.601 1.086-1.601 2.206v4.249h-2.667v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.779 3.203 4.092v4.711Z"
                  ></path>
                </svg>
                <span class="screen-reader-text">NESTOR on LinkedIn</span>
              </a>
            </li>
          </ul>
        </nav>
      </div>

      {
        isHome ? (
          <div class="site-hero">
            <div class="site-hero__eu">
              <img
                src={withBase(euFunding.badge.src)}
                alt={euFunding.badge.alt}
                width="1024"
                height="228"
              />
            </div>

            <div class="site-hero__body">
              <h1 class="wp-block-heading has-text-align-left">{hero.heading}</h1>
              <div class="site-hero__copy">
                {hero.paragraphs.map((text) => (
                  <p class="has-text-align-left wp-block-paragraph">{text}</p>
                ))}
                <div class="wp-block-buttons">
                  <div class="wp-block-button is-style-outline">
                    <a class="wp-block-button__link" href={withBase(hero.cta.href)}>
                      {hero.cta.label}
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ) : (
          <p class="site-title">{site.title}</p>
        )
      }
    </div>
  </div>
</header>

<style>
  .site-cover {
    position: relative;
    display: flex;
    align-items: stretch;
    overflow: hidden;
    background-color: var(--color-tertiary);
  }

  /* The live front page cover is pinned to the full viewport height. */
  .site-cover--home {
    min-height: 100vh;
  }

  .site-cover__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  /* Matches WordPress's .has-background-dim, which is 50%. */
  .site-cover__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: var(--color-tertiary);
    opacity: 0.5;
  }

  .site-cover--inner .site-cover__overlay {
    opacity: 1;
  }

  .site-cover__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-60);
    width: 100%;
    max-width: var(--wide-size);
    margin-inline: auto;
    padding-block: var(--spacing-50);
  }

  /* Live cover padding: 2vh 4vw 8vh 4vw. */
  .site-cover--home .site-cover__inner {
    padding: 2vh 4vw 8vh;
  }

  /* ----------------------------------------------------------- top bar ---- */

  .site-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-50);
    flex-wrap: wrap;
  }

  .site-logo {
    flex: 0 0 auto;
    display: block;
    line-height: 0;
  }

  .site-logo img {
    width: clamp(160px, 18vw, 240px);
    height: auto;
  }

  /* -------------------------------------------------------- navigation ---- */

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--spacing-30);
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__list .wp-block-button__link {
    font-size: 0.72rem;
    padding: 0.7em 1.35em;
    background-color: transparent;
    border: 1px solid rgb(234 234 234 / 0.35);
    color: var(--color-contrast);
    white-space: nowrap;
  }

  .site-nav__list .wp-block-button__link:hover,
  .site-nav__list .wp-block-button__link[aria-current='page'] {
    background-color: var(--color-secondary);
    border-color: var(--color-secondary);
    color: var(--color-tertiary);
  }

  .site-nav__social {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgb(234 234 234 / 0.35);
    color: var(--color-contrast);
  }

  .site-nav__social:hover {
    background-color: var(--color-secondary);
    border-color: var(--color-secondary);
    color: var(--color-tertiary);
  }

  .site-nav__toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(234 234 234 / 0.35);
    border-radius: 6px;
    background: transparent;
    cursor: pointer;
  }

  .site-nav__bars,
  .site-nav__bars::before,
  .site-nav__bars::after {
    display: block;
    width: 20px;
    height: 2px;
    margin-inline: auto;
    background: var(--color-contrast);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .site-nav__bars::before,
  .site-nav__bars::after {
    content: '';
    position: relative;
  }
  .site-nav__bars::before {
    top: -6px;
  }
  .site-nav__bars::after {
    top: 4px;
  }

  /* --------------------------------------------------------------- hero ---- */

  .site-hero {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-60);
    flex: 1 1 auto;
    justify-content: flex-end;
  }

  .site-hero__eu img {
    width: clamp(200px, 22vw, 280px);
    height: auto;
  }

  .site-hero__body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-60);
    align-items: end;
  }

  .site-hero__body h1 {
    margin: 0;
  }

  .site-hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-40);
    align-items: flex-start;
  }

  /* Matches the live h1.wp-block-site-title (large size, capitalized). */
  .site-title {
    margin: 0;
    font-size: var(--font-size-large);
    line-height: 1.2;
    text-transform: capitalize;
  }

  /* -------------------------------------------------------- responsive ---- */

  @media (max-width: 900px) {
    .site-hero__body {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }

  @media (max-width: 782px) {
    .site-nav__toggle {
      display: grid;
      place-items: center;
    }

    .site-nav__list {
      display: none;
      position: absolute;
      right: var(--global-padding);
      left: var(--global-padding);
      margin-top: var(--spacing-40);
      padding: var(--spacing-50);
      flex-direction: column;
      align-items: stretch;
      gap: var(--spacing-40);
      background: var(--color-tertiary);
      border: 1px solid rgb(234 234 234 / 0.18);
      border-radius: 8px;
      z-index: 20;
    }

    .site-nav__list.is-open {
      display: flex;
    }

    .site-nav__list .wp-block-button__link {
      text-align: center;
      white-space: normal;
    }

    .site-nav__social {
      margin-inline: auto;
    }

    .site-cover--home {
      min-height: auto;
      padding-block-end: var(--spacing-70);
    }
  }

  /*
   * Reduced motion is handled by pausing the video in JS (below), which leaves
   * its first frame on screen. Do NOT hide it: `prefers-reduced-motion: reduce`
   * is set by default on many Windows installs, and hiding the element there
   * removed the hero background entirely.
   */
</style>

<script>
  /*
   * Respect reduced-motion by pausing the hero video rather than hiding it, so
   * its first frame still acts as the cover image.
   */
  const video = document.querySelector<HTMLVideoElement>('.site-cover__video')
  if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.removeAttribute('autoplay')
    video.pause()
    // Nudge the frame forward so a black leading frame isn't what's shown.
    video.addEventListener(
      'loadeddata',
      () => {
        try {
          video.currentTime = 0.1
        } catch {
          /* seeking unsupported before metadata lands — harmless */
        }
      },
      { once: true }
    )
  }

  // Mobile menu toggle. Scoped per-header so it works on every page variant.
  document.querySelectorAll<HTMLElement>('.site-nav').forEach((nav) => {
    const toggle = nav.querySelector<HTMLButtonElement>('.site-nav__toggle')
    const list = nav.querySelector<HTMLElement>('.site-nav__list')
    if (!toggle || !list) return

    toggle.addEventListener('click', () => {
      const open = list.classList.toggle('is-open')
      toggle.setAttribute('aria-expanded', String(open))
    })
  })
</script>
